# ==============================================================================
# NOVAPAY ENVIRONMENT CONFIGURATION TEMPLATE
# Target Network: MIDNIGHT PREVIEW
# Copy this file to .env.local (frontend) or server/.env (backend)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & NETWORK
# ------------------------------------------------------------------------------
# Options: development | preview | production
NODE_ENV=preview

# Target Blockchain: STRICTLY 'preview'. Mainnet is strictly prohibited.
NEXT_PUBLIC_MIDNIGHT_NETWORK=preview
MIDNIGHT_NETWORK=preview

# ------------------------------------------------------------------------------
# 2. MIDNIGHT NETWORK CONFIGURATION (PREVIEW)
# ------------------------------------------------------------------------------
# Midnight Preview RPC Node
NEXT_PUBLIC_MIDNIGHT_RPC_URL=https://rpc.preview.midnight.network
MIDNIGHT_RPC_URL=https://rpc.preview.midnight.network

# Midnight Preview GraphQL Indexer
NEXT_PUBLIC_MIDNIGHT_INDEXER_URL=https://indexer.preview.midnight.network/graphql
MIDNIGHT_INDEXER_URL=https://indexer.preview.midnight.network/graphql

# Midnight Preview Block Explorer
NEXT_PUBLIC_MIDNIGHT_EXPLORER_URL=https://explorer.1am.xyz
MIDNIGHT_EXPLORER_URL=https://explorer.1am.xyz

# Local / Hosted ZK Proof Server
NEXT_PUBLIC_MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300
MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300

# Midnight Native Asset ID
NEXT_PUBLIC_MIDNIGHT_ASSET_ID=tDUST
MIDNIGHT_ASSET_ID=tDUST

# Compiled Compact Package Identifier
NEXT_PUBLIC_MIDNIGHT_PACKAGE_ID=
MIDNIGHT_PACKAGE_ID=

# Deployed Contract Addresses on Midnight Preview
NEXT_PUBLIC_MIDNIGHT_CONTRACT_ADDRESS=
MIDNIGHT_CONTRACT_ADDRESS=
NEXT_PUBLIC_MIDNIGHT_ESCROW_CONTRACT_ADDRESS=mn_contract1_escrow_preview_mt8xjoflwwff
MIDNIGHT_ESCROW_CONTRACT_ADDRESS=mn_contract1_escrow_preview_mt8xjoflwwff
NEXT_PUBLIC_MIDNIGHT_RECURRING_CONTRACT_ADDRESS=mn_contract1_recurring_preview_mt8xjoflwwff
MIDNIGHT_RECURRING_CONTRACT_ADDRESS=mn_contract1_recurring_preview_mt8xjoflwwff

# ------------------------------------------------------------------------------
# 3. BACKEND SERVICE & NETWORKING
# ------------------------------------------------------------------------------
PORT=5000
NEXT_PUBLIC_API_URL=http://localhost:5000

# Comma-separated list of allowed CORS origins (No wildcards in Preview/Production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://preview.novapay.finance

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Development: file:./dev.db
# Preprod / Production: postgresql://<user>:<password>@<host>:5432/<database>?schema=public
DATABASE_URL=postgresql://novapay_admin:CHANGE_ME_DATABASE_PASSWORD@localhost:5432/novapay_preprod?schema=public
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & SECRETS (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 48 (minimum 32 characters required)
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_CRYPTOGRAPHIC_SECRET_KEY
JWT_REFRESH_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_REFRESH_SECRET_KEY
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
WALLET_CHALLENGE_TTL_MS=300000

# ------------------------------------------------------------------------------
# 6. 1AM WALLET INTEGRATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ONEAM_PROVIDER_ID=1am
ONEAM_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 7. FAIRWAY — KYC / AML COMPLIANCE (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
FAIRWAY_ENVIRONMENT=sandbox
FAIRWAY_API_URL=https://api.sandbox.fairway.compliance/v1
FAIRWAY_API_KEY=
FAIRWAY_CLIENT_ID=
FAIRWAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 8. IDENTUS — DECENTRALIZED IDENTITY & VC (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
IDENTUS_ENVIRONMENT=sandbox
IDENTUS_AGENT_URL=https://identus.preview.midnight.network/cloud-agent
IDENTUS_API_KEY=
IDENTUS_ISSUER_DID=
IDENTUS_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 9. TRIPLE PLAY — ZERO-KNOWLEDGE COMPLIANCE ENGINE (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
TRIPLE_PLAY_ENVIRONMENT=sandbox
TRIPLE_PLAY_API_URL=https://api.sandbox.tripleplay.compliance/v1
TRIPLE_PLAY_API_KEY=
TRIPLE_PLAY_ENGINE_ID=

# ------------------------------------------------------------------------------
# 10. MONEYGRAM — PAYMENT ECOSYSTEM (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
MONEYGRAM_ENVIRONMENT=sandbox
MONEYGRAM_SANDBOX_URL=https://api.sandbox.moneygram.com/v1
MONEYGRAM_PARTNER_ID=
MONEYGRAM_API_KEY=
MONEYGRAM_CLIENT_SECRET=
MONEYGRAM_WEBHOOK_HMAC_KEY=

# ------------------------------------------------------------------------------
# 11. WORLDPAY — INSTITUTIONAL PAYMENT RAILS (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
WORLDPAY_ENVIRONMENT=sandbox
WORLDPAY_SANDBOX_URL=https://api.sandbox.worldpay.com/v1
WORLDPAY_MERCHANT_ID=
WORLDPAY_SERVICE_KEY=
WORLDPAY_CLIENT_KEY=
WORLDPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 12. WEBHOOK SIGNING & SECURITY (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
WEBHOOK_SIGNING_SECRET=CHANGE_ME_WEBHOOK_HMAC_SHA256_SIGNING_SECRET
WEBHOOK_ALLOWED_HOSTS=api.sandbox.moneygram.com,api.sandbox.worldpay.com,identus.preprod.midnight.network
WEBHOOK_TIMESTAMP_TOLERANCE_SECS=300
