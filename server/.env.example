# ==============================================================================
# NOVAPAY SERVER ENVIRONMENT CONFIGURATION
# Target Network: MIDNIGHT PREVIEW
# Copy this file to server/.env
# ==============================================================================

# Application Environment (development | preview | production)
NODE_ENV=preview
PORT=5000

# Strict Network Target: MUST be 'preview'. Mainnet is strictly blocked.
MIDNIGHT_NETWORK=preview

# Midnight Preview RPC Node & Indexer
MIDNIGHT_RPC_URL=https://rpc.preview.midnight.network
MIDNIGHT_INDEXER_URL=https://indexer.preview.midnight.network/graphql
MIDNIGHT_EXPLORER_URL=https://explorer.1am.xyz
MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300
MIDNIGHT_ASSET_ID=tDUST

# Compact Package & Preview Contract Addresses
MIDNIGHT_PACKAGE_ID=
MIDNIGHT_CONTRACT_ADDRESS=
MIDNIGHT_ESCROW_CONTRACT_ADDRESS=mn_contract1_escrow_preview_mt8xjoflwwff
MIDNIGHT_RECURRING_CONTRACT_ADDRESS=mn_contract1_recurring_preview_mt8xjoflwwff

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://preview.novapay.finance

# Database Connection (PostgreSQL for Preview / SQLite for local development)
DATABASE_URL="postgresql://novapay_admin:CHANGE_ME_DATABASE_PASSWORD@localhost:5432/novapay_preview?schema=public"
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT_MS=10000

# Authentication (Minimum 32 characters required in Preview/Production)
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_CRYPTOGRAPHIC_SECRET_KEY
JWT_REFRESH_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_REFRESH_SECRET_KEY
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
WALLET_CHALLENGE_TTL_MS=300000

# 1AM Wallet Config
ONEAM_TIMEOUT_MS=15000

# KYC/AML Provider — Fairway
FAIRWAY_ENVIRONMENT=sandbox
FAIRWAY_API_URL=https://api.sandbox.fairway.compliance/v1
FAIRWAY_API_KEY=
FAIRWAY_CLIENT_ID=
FAIRWAY_WEBHOOK_SECRET=

# DID/VC Provider — Identus
IDENTUS_ENVIRONMENT=sandbox
IDENTUS_AGENT_URL=https://identus.preview.midnight.network/cloud-agent
IDENTUS_API_KEY=
IDENTUS_ISSUER_DID=
IDENTUS_WEBHOOK_SECRET=

# ZK Compliance — Triple Play
TRIPLE_PLAY_ENVIRONMENT=sandbox
TRIPLE_PLAY_API_URL=https://api.sandbox.tripleplay.compliance/v1
TRIPLE_PLAY_API_KEY=
TRIPLE_PLAY_ENGINE_ID=

# Payment Ecosystem — MoneyGram
MONEYGRAM_ENVIRONMENT=sandbox
MONEYGRAM_SANDBOX_URL=https://api.sandbox.moneygram.com/v1
MONEYGRAM_PARTNER_ID=
MONEYGRAM_API_KEY=
MONEYGRAM_CLIENT_SECRET=
MONEYGRAM_WEBHOOK_HMAC_KEY=

# Institutional Payments — Worldpay
WORLDPAY_ENVIRONMENT=sandbox
WORLDPAY_SANDBOX_URL=https://api.sandbox.worldpay.com/v1
WORLDPAY_MERCHANT_ID=
WORLDPAY_SERVICE_KEY=
WORLDPAY_CLIENT_KEY=
WORLDPAY_WEBHOOK_SECRET=

# Webhook Security
WEBHOOK_SIGNING_SECRET=CHANGE_ME_WEBHOOK_HMAC_SHA256_SIGNING_SECRET
WEBHOOK_ALLOWED_HOSTS=api.sandbox.moneygram.com,api.sandbox.worldpay.com,identus.preprod.midnight.network
WEBHOOK_TIMESTAMP_TOLERANCE_SECS=300
